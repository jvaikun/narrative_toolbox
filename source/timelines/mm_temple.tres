metadata/_custom_type_script = "uid://5e50cn5p01dd"

[sub_resource type="Resource" id="Resource_1sxrp"]
script = ExtResource("2_qclhi")
lines = "Seeing that you've gotten what you can from investigating the temple, you make your way out. You pause for a moment outside the temple to consider where you will go next..."
metadata/_custom_type_script = "uid://qiibr5iabuqw"

