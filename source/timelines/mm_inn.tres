[sub_resource type="Resource" id="Resource_jkg6o"]
script = ExtResource("2_1l4o0")
lines = "You leave the inn slightly frustrated. The previous agents' equipment and supplies may as well be scattered to the four winds at this point. Still, that's at least one piece of information that's new. Nothing left but to press on, as you ponder the next place to investigate..."
metadata/_custom_type_script = "uid://qiibr5iabuqw"

