[sub_resource type="Resource" id="Resource_qclhi"]
script = ExtResource("2_e7f1k")
lines = "Market Square
Fendringham's market square is crawling with armed militiamen, their expressions grim. Patrols frequently pass through, giving updates to the militia commander before continuing their rounds. You hear muttering and bickering about whether 'another pack' will come by."
metadata/_custom_type_script = "uid://qiibr5iabuqw"

