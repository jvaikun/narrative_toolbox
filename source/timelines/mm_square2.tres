[sub_resource type="Resource" id="Resource_qclhi"]
script = ExtResource("4_d5tt4")
lines = "Fendringham's market square is crawling with armed militiamen, their expressions grim. Patrols frequently pass through, giving updates to the militia commander before continuing their rounds. You hear muttering and bickering about whether 'another pack' will come by.
Dominating the middle of the square is a pile of charred remains that are distressingly human shaped, the waning light and deepening shadows making their shapes all the more grotesque. You approach for a closer look, but are stopped by one of the militiamen.
\"Careful now,\" he cautions. \"That's undead remains there. Ghouls, they were. They been attacking the village in packs every other bloody night.\"
This is distressing news. Ghouls are supposed to be carrion feeders, not marauding pack hunters. You ought to find out more."
metadata/_custom_type_script = "uid://qiibr5iabuqw"

