[sub_resource type="Resource" id="Resource_sf3n2"]
script = ExtResource("4_edend")
lines = "You follow the innkeeper back to the main entrace, where he is frantically barring the door shut, and shoving furniture to further barricade it. The King's man joins him in his efforts. 
You are about to do the same when something crashes through the window! The foul stench of rot that fills the room soon after leaves no room for doubt: the town is being attacked by an undead scourge! The hideous creature crouched before you appears to be a Ghoul, a particularly foul undead with paralytic venom in its claws. You must fight this menace!"
metadata/_custom_type_script = "uid://qiibr5iabuqw"

