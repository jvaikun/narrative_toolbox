[sub_resource type="Resource" id="Resource_7p6hl"]
script = ExtResource("3_5kk4y")
lines = "The temple is dedicated to the God of Ways. Normally, it would be filled with all manner of guests and travellers seeking blessings or divine guidance for their journeys. At the moment however, the space is occupied by the sick and wounded, tended to by healers and volunteers.
The wounded all seem to have sustained grievous injuries. Whether they were mauled by beasts, or savaged by bandits, you cannot say.
The sick appear to be separated from the wounded, relegated to a cordoned off area in the back. A censer sits in the middle of that area, emanating smoke that smells sharply of herbs and resin."
metadata/_custom_type_script = "uid://qiibr5iabuqw"

[sub_resource type="Resource" id="Resource_sfsyt"]
script = ExtResource("3_5kk4y")
lines = "One of the volunteers approaches you. She appears to be a local hedge witch or wise woman, likely pitching in to help the healers. \"You both look well. Are you here to lend a hand?\" she asks.
You explain that you are here to help, in a manner of speaking, to which she scoffs. \"Well, miasma's not something you can hold at sword point. I think fighting off the undead is more your speed,\" she says.
You are about to ask her about the miasma, when you hear the loud clanging of a bell from outside. \"Damn it all, another attack? Come on, help us with the barricade!\" barks out the hedge witch."
metadata/_custom_type_script = "uid://qiibr5iabuqw"

[sub_resource type="Resource" id="Resource_g5pcy"]
script = ExtResource("6_b4t42")
audio = ExtResource("5_vab0l")
