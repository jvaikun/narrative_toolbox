metadata/_custom_type_script = "uid://daxaos2xxqnnj"

[sub_resource type="Resource" id="Resource_i3a5k"]
script = ExtResource("3_5kk4y")
lines = "You rush ahead of the healers and exit the temple before they bar the main doors. Outside, you can see a few militiamen fighting hideous creatures. The stench of rot emanating from them tells you everything: Ghouls.
Leaping into action, you engage the nearest fiend!"
metadata/_custom_type_script = "uid://qiibr5iabuqw"

