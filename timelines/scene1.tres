[sub_resource type="Resource" id="Resource_l04ru"]
script = ExtResource("4_ptfnm")
lines = "At last, you arrive at Fendringham, just as night falls. The coaching inn is larger than you expected, but your coach is only one of two on the grounds.
Normally, you would wait to set up a base of operations at a larger settlement, but Fendringham is the closest village to the mansion in a sparsely populated area.
\"We should see to getting a room and secure storage. Gathering information wouldn't hurt either,' declares the King's man as he disembarks. 
He then asks, \"Would you mind having a look around while I arrange for room and board?\""
metadata/_custom_type_script = "uid://qiibr5iabuqw"

[sub_resource type="Resource" id="Resource_i4tv2"]
script = ExtResource("6_0ocij")
title = "I'll have a look around"
metadata/_custom_type_script = "uid://dkfdnmlrdhh5u"

