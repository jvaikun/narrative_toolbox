metadata/_custom_type_script = "uid://40q0ab7v28b4"

[sub_resource type="Resource" id="Resource_cb3ot"]
script = ExtResource("4_ptfnm")
lines = "You have been hired by the Crown to escort one of their representatives to some derelict country manor called Mortus Mansion.
Not being choosy about where your gold comes from, you agreed to their generous terms.
Your first stop will be the nearby village of Fendringham, quite a ride from Lake Libra, giving you plenty of time to ponder the job."
metadata/_custom_type_script = "uid://qiibr5iabuqw"

[sub_resource type="Resource" id="Resource_u7t40"]
script = ExtResource("3_ptfnm")
image = ExtResource("5_x6t2e")
metadata/_custom_type_script = "uid://40q0ab7v28b4"

[sub_resource type="Resource" id="Resource_ghngd"]
script = ExtResource("4_ptfnm")
lines = "The road to Fendringham is a narrow, ragged thing. Neglect and lack of traffic have allowed the wilderness to choke the old road into the rough path the coach is attempting to navigate.
You and the Crown agent feel like a pair of dice as the coach shakes and rattles from traversing the uneven ground.
Despite that, the King's man tries his best to make conversation, if only to make the trip more bearable.
\"What do you suppose happened to the fellow we sent?\" he wonders aloud. \"You don't suppose some lingering evil lurks there still, do you?\""
metadata/_custom_type_script = "uid://qiibr5iabuqw"

[sub_resource type="Resource" id="Resource_0ocij"]
script = ExtResource("4_ptfnm")
lines = "The Crown agent chuckles nervously. \"I suppose there is some benefit coming into this expecting a fight,\" he replies. \"Although I would prefer a more mundane culprit for our man's seeming disappearance.\""
metadata/_custom_type_script = "uid://qiibr5iabuqw"

[sub_resource type="Resource" id="Resource_3f4fo"]
script = ExtResource("6_0ocij")
title = "Agree"
events = Array[ExtResource("1_lsnxd")]([SubResource("Resource_0ocij")])
metadata/_custom_type_script = "uid://dkfdnmlrdhh5u"

[sub_resource type="Resource" id="Resource_kbhlj"]
script = ExtResource("4_ptfnm")
lines = "The Crown agent's expression brightens visibly. \"Good to know that you're taking the rumors with a grain of salt,\" he replies. \"It's far more likely that everyday ne'er do wells are responsible for our man's lack of contact. Looters or brigands, I'd say.\""
metadata/_custom_type_script = "uid://qiibr5iabuqw"

[sub_resource type="Resource" id="Resource_v6k4r"]
script = ExtResource("6_0ocij")
title = "Disagree"
events = Array[ExtResource("1_lsnxd")]([SubResource("Resource_kbhlj")])
metadata/_custom_type_script = "uid://dkfdnmlrdhh5u"

[sub_resource type="Resource" id="Resource_2afs7"]
script = ExtResource("4_ptfnm")
lines = "The Crown agent's expression sours. \"Come now, our man is likely in distress,\" he chides, wagging his finger. \"It would not do to be so indifferent to his plight!\""
metadata/_custom_type_script = "uid://qiibr5iabuqw"

[sub_resource type="Resource" id="Resource_ok8hj"]
script = ExtResource("6_0ocij")
title = "Shrug"
events = Array[ExtResource("1_lsnxd")]([SubResource("Resource_2afs7")])
metadata/_custom_type_script = "uid://dkfdnmlrdhh5u"

